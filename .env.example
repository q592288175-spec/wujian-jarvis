# Optional. Keep the real key only in .env on this computer.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
PORT=4318
JIN10_MCP_TOKEN=
# 可选元宝搜索 API Key；未配置时使用公开来源。实际密钥只放本机 .env。
TENCENTCLOUD_WSA_APIKEY=
# 本机每日最多调用次数；0 禁用付费搜索，仍保留公开来源。
WUJIAN_SEARCH_DAILY_LIMIT=60

# TqSdk service credentials, NOT broker credentials
TQ_USER=
TQ_PASSWORD=
TQ_SYMBOLS=KQ.m@SHFE.cu,KQ.m@SHFE.au,KQ.m@SHFE.rb
# 登录面板自动查找项目内 Python；仅自定义环境时填写。Windows 例：.venv-data/Scripts/python.exe
TQ_PYTHON=

# 原生全双工：GPT-Live 语音 + DeepSeek 后台。仅在本机填写。
OPENAI_API_KEY=

# 飞书企业自建机器人，官方长连接。本机填写后重启，不提交实际值。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_BOT_OPEN_ID=
FEISHU_RECEIVE_ID_TYPE=open_id
FEISHU_RECEIVE_ID=
# 定时默认关闭，在工作台 数据来源 → 飞书 中预览并启用。

# Volcengine speech console API key (new authentication)
VOLC_VOICE_API_KEY=
VOLC_VOICE_APP_ID=
VOLC_VOICE_ACCESS_TOKEN=
# legacy or duplex; Windows encrypted configuration overrides these optional values.
VOLC_VOICE_PROTOCOL=duplex
